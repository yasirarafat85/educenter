# EduCenter — ক্লিন URL (.php লুকানো)
# লোকাল (সাবডিরেক্টরি /website) ও লাইভ (ডোমেইন রুট) — দুই জায়গাতেই কাজ করে।
# THE_REQUEST-ভিত্তিক %1 এ সাবডিরেক্টরি প্রিফিক্স সহ পুরো পাথ থাকে, তাই redirect নিরাপদ।
# admin/ ফোল্ডার ও ফাংশনাল endpoint (-submit / ajax-* / log-download / sitemap / sms-in) ইচ্ছাকৃতভাবে বাদ।

<IfModule mod_rewrite.c>
    RewriteEngine On

    # (B) /index.php (যেকোনো ফোল্ডারে) → সেই ফোল্ডারের রুট  (GET only)
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/+([^\s?]*/)?index\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # (A) দৃশ্যমান /foo.php → /foo  (GET only; admin ও ফাংশনাল endpoint বাদ)
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.php[\s?] [NC]
    RewriteCond %{REQUEST_URI} !(^|/)admin/ [NC]
    RewriteCond %{REQUEST_URI} !-submit\.php$ [NC]
    RewriteCond %{REQUEST_URI} !/(ajax-[^/]+|log-download|sitemap|sms-in)\.php$ [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # extensionless URL → আসল .php ফাইল (থাকলে) — অভ্যন্তরীণ rewrite, query string সহ (QSA)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]

    # (C2) পড়ার-মতো আইটেম URL → detail.php  (২০২৬-০৯-২৭)
    #      /course-12-হাতের-লেখা  ·  /worksheet-4-বাংলা-প্যাক  ·  /product-9-বই
    # 🔴 আইডিটাই আসল চাবি; নামের অংশটা ঐচ্ছিক ও উপেক্ষিত — তাই অ্যাডমিন নাম বদলালেও
    #    পুরনো শেয়ার করা লিংক কাজ করে (বিস্তারিত: functions.php-এর item_url())।
    # 🔴🔴 স্ল্যাশ নয়, **হাইফেন** — `course/12-...` রূপটা এক ফোল্ডার গভীরে বলে ঐ পাতা
    #    থেকে সাইটের সব রিলেটিভ অ্যাসেট/লিংক (`assets/css/style.css`, `href="courses"`)
    #    ৪০৪ হয়ে যেত, পেজ সম্পূর্ণ স্টাইলহীন দেখাত (২০২৬-০৯-২৭ সন্ধ্যায় লাইভে ধরা)।
    #    সাইটের নিয়মই রিলেটিভ লিংক (সাবডিরেক্টরি ইনস্টলের জন্য), তাই গভীরতা বাড়ানো চলবে না।
    # ⚠️ রুল (C)-এর পরে থাকতেই হবে: ওটা `<path>.php` ফাইল থাকলে সেটাই দেয় — তাই
    #    `course-register`/`course-interest`-এর মতো আসল পাতা আগেই ধরা পড়ে যায়, আর
    #    এখানে শুধু `course-<সংখ্যা>` রূপই আসে (রেগেক্সে সংখ্যা বাধ্যতামূলক)।
    # ⚠️ নামের অংশে বাংলা থাকে (URL-এনকোডেড), তাই `[^/]*` — শুধু ASCII ধরে নেবেন না।

    # (C2a) পুরনো নেস্টেড রূপ → নতুন সমতল রূপে ৩০১ (২০২৬-০৯-২৭ সন্ধ্যা)
    # যে কয়েক ঘণ্টা `/course/12-নাম` লিংক শেয়ার হয়েছে সেগুলো যেন ভাঙা/স্টাইলহীন পাতা
    # না দেখায়। 🔴 এখানে ৩০১ নিরাপদ, কারণ এই রূপটার অস্তিত্বই mod_rewrite-এর কারণে
    # (পুরনো `detail?type=..&id=..`-এ ৩০১ দেওয়া হয়নি — ওটা rewrite ছাড়াও চলে)।
    # 🔴 গন্তব্য THE_REQUEST থেকে বানানো (রুল A/B-এর হুবহু প্যাটার্ন) — সরাসরি `/$1-$2$3`
    #    লিখলে সেটা ডকুমেন্ট-রুট ধরে নিত, আর সাবডিরেক্টরি ইনস্টলে (`/website/…`) প্রিফিক্স
    #    হারিয়ে ভুল জায়গায় পাঠাত। `%1` = প্রিফিক্স (লাইভে খালি, লোকালে `website/`)।
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/+([^\s?]*?)(course|worksheet|product)/([0-9]+)(-[^\s?/]*)?/?[\s?] [NC]
    RewriteRule ^(course|worksheet|product)/([0-9]+)(-[^/]*)?/?$ /%1%2-%3%4 [R=301,L,NE,QSA]

    RewriteRule ^(course|worksheet|product)-([0-9]+)(-[^/]*)?/?$ detail.php?type=$1&id=$2 [L,QSA]

    # (D) যা কিছুই মিলল না → সাইটের নিজের ৪০৪ পেজ (২০২৬-০৯-২৭)
    # 🔴 ইচ্ছাকৃতভাবে `ErrorDocument 404 /404.php` ব্যবহার করা হয়নি — Apache সেখানে
    #    ডকুমেন্ট-রুট থেকে absolute পাথ চায়, তাই লাইভে (`/404.php`) চললেও লোকাল
    #    সাবডিরেক্টরিতে (`/website/404.php`) ভেঙে যেত। mod_rewrite-এর substitution
    #    .htaccess যে ফোল্ডারে সেটার সাপেক্ষে হয়, তাই এই নিয়মটা দুই জায়গাতেই চলে।
    # HTTP স্ট্যাটাস ৪০৪ বসায় 404.php নিজেই (`http_response_code(404)`) — গুগল যেন
    # "soft 404" হিসেবে ইনডেক্স না করে।
    # ⚠️ অনুপস্থিত ছবি/CSS/JS-এ পুরো HTML পাঠানো অপচয়, তাই সেগুলো বাদ (Apache-এর
    #    নিজের সংক্ষিপ্ত ৪০৪-ই যাবে)। admin/ ও বাদ — ওখানকার নিজের গার্ড চলুক।
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !(^|/)admin/ [NC]
    RewriteCond %{REQUEST_URI} !\.(css|js|map|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot|xml|txt|json|pdf|zip)$ [NC]
    RewriteRule ^ 404.php [L]
</IfModule>

# ── gzip কম্প্রেশন (২০২৬-০৯-২৭) ──────────────────────────────────────────────
# টেক্সট-ফাইল (HTML/CSS/JS/SVG) ~৭০% ছোট হয়ে যায় — মোবাইল নেটে সবচেয়ে বড় লাভ।
# ⚠️ ছবি/woff2 আগে থেকেই কম্প্রেসড, ওগুলো আবার চাপলে উল্টো CPU নষ্ট হয় — তাই বাদ।
# মডিউল না থাকলে <IfModule> গার্ডে পুরো ব্লকটা নীরবে বাদ যায় (সাইট ভাঙে না)।
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── ব্রাউজার ক্যাশিং ─────────────────────────────────────────────────────────
# 🔴 নিরাপদ, কারণ CSS/JS-এর লিংকে `?v=filemtime()` বসে — ফাইল বদলালেই URL বদলায়,
#    তাই ব্রাউজার নতুনটা নামায়। **নতুন কোনো CSS/JS যোগ করলে সেটাতেও `?v=` দিতেই হবে**,
#    নাহলে ইউজারের ব্রাউজারে এক বছর পুরনোটা আটকে থাকতে পারে।
# 🔴 HTML কখনো ক্যাশ করা হয় না — কোর্স/দাম/নোটিশ বদলালে সাথে সাথে দেখা যেতে হবে।
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 hour"
    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 6 months"
    ExpiresByType image/png                 "access plus 6 months"
    ExpiresByType image/webp                "access plus 6 months"
    ExpiresByType image/gif                 "access plus 6 months"
    ExpiresByType image/svg+xml             "access plus 6 months"
    ExpiresByType image/x-icon              "access plus 6 months"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/font-woff2    "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # ফন্ট ফাইল কখনো বদলায় না (নামে হ্যাশ আছে) — immutable দিলে ব্রাউজার পুনরায় জিজ্ঞাসাও করে না
    <FilesMatch "\.(woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # HTML সবসময় তাজা
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
